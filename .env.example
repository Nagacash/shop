# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generate-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Ambient beat stream signing (falls back to BETTER_AUTH_SECRET if unset)
AMBIENT_MEDIA_SECRET="generate-another-long-random-string"

# Public site URL (production: https://www.nagaclub.de)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Transactional email (Resend)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Naga Club <orders@yourdomain.com>"

# Admin access (comma-separated emails)
ADMIN_EMAILS="admin@example.com"

# OAuth — optional
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED="false"

# Naga Glue plugin downloads (hosted zips — do not commit binaries)
# TODO: set to GitHub Releases, R2, or S3 URLs when builds are uploaded
NEXT_PUBLIC_NAGA_GLUE_V1_PURCHASE_URL=""
NEXT_PUBLIC_NAGA_GLUE_V1_DOWNLOAD_MAC_VST3AU=""
NEXT_PUBLIC_NAGA_GLUE_V1_DOWNLOAD_WIN_VST3=""
# Leave empty to use /api/plugins/naga-glue-vol-2/download when private/digital zip exists on the server
NEXT_PUBLIC_NAGA_GLUE_V2_DOWNLOAD_MAC_VST3AU=""
NEXT_PUBLIC_NAGA_GLUE_V2_DOWNLOAD_WIN_VST3=""
NEXT_PUBLIC_NAGA_GLUE_V2_DOWNLOAD_STANDALONE=""
